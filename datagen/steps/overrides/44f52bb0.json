{
  "kwargs": {
    "width": {
      "type": "int",
      "range": [
        3,
        30
      ]
    },
    "height": {
      "type": "int",
      "range": [
        3,
        30
      ]
    },
    "count": {
      "type": "int",
      "range": [
        1,
        899
      ]
    },
    "num_colors": {
      "type": "int",
      "range": [
        2,
        9
      ]
    },
    "density": {
      "type": "int",
      "range": [
        1,
        100
      ]
    }
  },
  "exclude": [
    "rows",
    "cols",
    "size"
  ],
  "foreground_recolor": "off"
}
