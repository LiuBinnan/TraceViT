{
  "kwargs": {
    "width": {
      "type": "int",
      "range": [
        4,
        30
      ]
    },
    "height": {
      "type": "int",
      "range": [
        4,
        30
      ]
    },
    "red_count": {
      "type": "int",
      "range": [
        1,
        4
      ]
    },
