{
  "kwargs": {
    "height": {
      "type": "int",
      "range": [
        8,
        30
      ]
    },
    "width": {
      "type": "int",
      "range": [
        8,
        30
      ]
    },
    "count": {
      "type": "int",
      "range": [
        1,
        10
      ]
    },
    "num_colors": {
      "type": "int",
      "range": [
        2,
        9
      ]
    },
    "background": {
      "type": "int",
      "range": [
        0,
        9
      ]
    }
  },
  "exclude": [
    "size",
    "rows",
    "cols",
    "wides",
    "talls",
    "dotrow",
    "dotcol",
    "colors"
  ]
}
